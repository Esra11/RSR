# Microsoft Foundry project endpoint, not a model deployment endpoint
PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT

# Exact name of the saved or published prompt agent
AGENT_NAME=YOUR-AGENT-NAME

# Optional but recommended when Azure CLI can access multiple subscriptions
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
